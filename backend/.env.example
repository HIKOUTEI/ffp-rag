# provider: zhipu(默认) | openai | qwen
LLM_PROVIDER=zhipu
# 智谱注册拿 key: https://open.bigmodel.cn
LLM_API_KEY=your_key_here
# 管理员接口（/admin/*）鉴权令牌，请改成一串随机字符串
ADMIN_TOKEN=change_me_to_a_random_secret
# 微信小程序登录凭据（微信公众平台 → 开发 → 开发设置）
WX_APPID=your_wx_appid
WX_APPSECRET=your_wx_appsecret
# 每人每日问答次数上限；0=不限
DAILY_LIMIT=50
# 每人每日报错（纠错记录）次数上限，与问答额度独立；0=不限
FEEDBACK_DAILY_LIMIT=10

# ---- 仅容器部署需要，本地开发留空即可 ----
# 可变状态目录（auth.db / changelog.db / popular.db / ingested.jsonl），需挂成卷
# DATA_DIR=/app/data
# 向量库目录，需挂成卷
# CHROMA_DIR=/app/chroma_db
