@import "/styles/reward.wxss";

/* 月结录入页自有样式。共用骨架在 styles/reward.wxss。 */

/* 抄数动线提示，放在首屏第一眼 */
.copy-hint {
  background: var(--brand-light);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.copy-hint-strong {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}
.copy-hint-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
  line-height: 1.5;
}

.existing-tip { padding: 8rpx 32rpx 0; }
