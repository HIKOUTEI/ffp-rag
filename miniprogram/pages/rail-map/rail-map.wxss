@import "/styles/rail.wxss";

/* 地图铺满一屏，页面本身不滚动 */
page { height: 100%; overflow: hidden; }

/* ===== 地图本体 =====
   100vh 是 webview 的高度（已经扣掉了原生导航栏），正好一屏。 */
.map-full {
  width: 100%;
  height: 100vh;
}

/* ===== 顶部信息条 =====
   ⚠️ 这一块是 cover-view，样式能力受限：
   不支持 box-shadow / background-image（渐变）/ backdrop-filter / transform，
   所以半透明只能靠 background-color 的 rgba，层次感靠不了投影。
   flex 的简写（flex: 1）在部分基础库上不生效，这里全部写成长属性。 */
.map-bar {
  position: fixed;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.92);
}
.map-bar-main {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-width: 0;
}
.map-bar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}
.map-bar-sub {
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 4rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}
.map-bar-close {
  flex-grow: 0;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  border-radius: 28rpx;
  background-color: rgba(60, 60, 67, 0.08);
  color: #8e8e93;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
}

/* 右上角提示，压在信息条下方一行 */
.map-tip {
  position: fixed;
  top: 132rpx;
  right: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 18rpx;
  background-color: rgba(28, 28, 30, 0.72);
  color: #ffffff;
  font-size: 22rpx;
}

/* ===== 加载中 / 加载失败 =====
   这两态是普通 view（地图还没渲染），不受 cover-view 的样式限制。 */
.map-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-weak);
  font-size: 28rpx;
}
.map-state-action { margin-top: 32rpx; }

/* ===== 空状态 ===== */
.map-empty { text-align: center; }
/* .rail-empty 自带 80rpx 下内边距，这里把小字往回收，贴着描述文案 */
.map-empty-hint {
  margin-top: -48rpx;
  color: var(--text-weak);
  font-size: 24rpx;
}
.map-empty-action {
  margin-top: 56rpx;
  padding: 0 60rpx;
}
