.wrap { padding: 28rpx; }

.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft);
  animation: fadeUp .5s var(--ease-spring) both;
}
.card:nth-child(2) { animation-delay: .08s; }
.card:nth-child(3) { animation-delay: .16s; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.title { font-size: 36rpx; font-weight: 600; }
.intro { margin-top: 16rpx; color: #4a5364; font-size: 28rpx; line-height: 1.7; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 18rpx;
}

.cov-group { margin-bottom: 20rpx; }
.cov-label { font-size: 27rpx; color: var(--text-weak); margin-bottom: 12rpx; }
.cov-items { display: flex; flex-wrap: wrap; }
.cov-tag {
  background: var(--brand-light);
  color: var(--brand);
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  margin: 0 14rpx 14rpx 0;
}

.disc-text { color: #6b7385; font-size: 26rpx; line-height: 1.75; }

.footer {
  text-align: center;
  color: #b3bccb;
  font-size: 24rpx;
  margin: 20rpx 0 40rpx;
}
