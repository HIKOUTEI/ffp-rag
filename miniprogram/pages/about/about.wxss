.wrap { padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom)); }

.hero { text-align: center; padding: 40rpx 0 32rpx; animation: fadeUp .5s var(--ease-spring) both; }
.hero-avatar {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  margin: 0 auto 22rpx; font-size: 56rpx; border-radius: 34rpx;
  background: linear-gradient(135deg, var(--brand), #5ab0ff);
  animation: breathe 3.4s ease-in-out infinite;
}
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { color: var(--text-weak); font-size: 26rpx; margin-top: 10rpx; }

.tags { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: flex-end; max-width: 460rpx; }
.disc-text { color: var(--text-weak); font-size: 26rpx; line-height: 1.75; }

.footer { text-align: center; color: #b3bccb; font-size: 24rpx; margin-top: 30rpx; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
