.wrap { padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom)); }

/* 头部 */
.hero { text-align: center; padding: 36rpx 0 28rpx; animation: fadeUp .5s var(--ease-spring) both; }
.hero-avatar {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  margin: 0 auto 22rpx; font-size: 56rpx; border-radius: 34rpx;
  background: linear-gradient(135deg, var(--brand), #5ab0ff);
  animation: breathe 3.4s ease-in-out infinite;
}
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { color: var(--text-weak); font-size: 26rpx; margin-top: 10rpx; }

/* 分区 */
.section { margin-bottom: 32rpx; animation: fadeUp .5s var(--ease-spring) both; }
.section-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 8rpx 16rpx;
}
.section-title { display: flex; align-items: center; gap: 12rpx; font-size: 30rpx; font-weight: 600; }
.section-icon { font-size: 34rpx; }
.section-add {
  width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: var(--brand-light);
}
.section-add:active { transform: scale(0.9); }

.empty { padding: 40rpx 0; }

/* 滑动删除按钮 */
.swipe-del {
  height: 100%; display: flex; align-items: center; justify-content: center;
  padding: 0 40rpx; background: #e34d59; color: #fff; font-size: 28rpx;
}

.footer { text-align: center; color: #b3bccb; font-size: 24rpx; margin-top: 20rpx; }

/* 录入面板 */
.form { padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background: var(--surface); border-radius: 24rpx 24rpx 0 0; }
.form-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.form-actions { display: flex; gap: 24rpx; margin-top: 40rpx; }
.btn-half { flex: 1; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
