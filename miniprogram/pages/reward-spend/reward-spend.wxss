@import "/styles/reward.wxss";

/* 逐笔签账页自有样式。共用骨架在 styles/reward.wxss。 */

/* DCC 开关那一行：说明文字占主体，开关靠右 */
.dcc-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0 8rpx;
  border-top: 2rpx solid var(--hairline);
  margin-top: 16rpx;
}
.dcc-main { flex: 1; min-width: 0; }

/* ===== 列表 =====
   外边距挂在 swipe-cell 上、卡片自身清零，否则侧滑出来的删除按钮会比卡片高一截
   （与行程页同一处理）。 */
.spend-item {
  display: block;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
}
.spend-card { margin-bottom: 0; }

.spend-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.spend-hkd {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}
.spend-sub {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
}
