.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* tabBar 高度（自定义 tabBar 约 100rpx） */
.page { --tabbar-h: 100rpx; }

/* 新对话：右上角悬浮圆按钮 */
.newchat-fab {
  position: fixed;
  top: 20rpx;
  right: 24rpx;
  z-index: 60;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.86);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 4rpx 16rpx rgba(20,40,80,0.1);
}
.newchat-fab:active { transform: scale(0.9); }

/* 滚动区：底部留出 发送器 + tabBar 的空间，避免最后消息被遮 */
.scroll {
  flex: 1;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

/* 发送器固定：紧贴 tabBar 顶部；安全区仅由 tabBar 处理，此处不再叠加 */
.sender-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--tabbar-h);
  z-index: 50;
  background: var(--surface);
}

/* 欢迎空状态 */
.welcome { text-align: center; padding: 72rpx 0 20rpx; animation: fadeUp .5s var(--ease-spring) both; }
.welcome-avatar {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  margin: 0 auto 24rpx; font-size: 56rpx; border-radius: 34rpx;
  background: linear-gradient(135deg, var(--brand), #5ab0ff);
  animation: breathe 3.4s ease-in-out infinite;
}
.welcome-title { font-size: 38rpx; font-weight: 700; }
.welcome-sub { color: var(--text-weak); font-size: 27rpx; margin-top: 12rpx; }

/* 热门问题：紧凑标签，flex 换行 */
.popular { margin-top: 48rpx; text-align: left; }
.popular-hint { font-size: 25rpx; color: var(--text-weak); margin-bottom: 18rpx; padding-left: 4rpx; }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { max-width: 100%; }

/* 报错入口：跟在 AI 气泡下方、与头像左对齐，弱化处理不抢视线 */
.msg-actions {
  display: flex;
  padding-left: 96rpx;
  margin: -8rpx 0 18rpx;
}
.report {
  font-size: 22rpx;
  color: var(--text-weak);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(20,40,80,0.04);
}
.report:active { transform: scale(0.94); }
.is-reported { color: var(--brand); opacity: 0.7; }

.disclaimer {
  margin: 30rpx 0 10rpx; font-size: 22rpx;
  color: var(--text-weak); text-align: center; line-height: 1.5;
}
.tail { height: 160rpx; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
