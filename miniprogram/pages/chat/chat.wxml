<view class="page">
  <!-- 新对话：右上角悬浮圆按钮 -->
  <view wx:if="{{messages.length}}" class="newchat-fab" bindtap="onNewChat">
    <t-icon name="add" size="40rpx" color="#0a84ff" />
  </view>

  <scroll-view class="scroll" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <!-- 空状态：欢迎 + 热门问题 -->
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <view class="welcome-avatar">✈️</view>
      <view class="welcome-title">你好，我是常旅客助手</view>
      <view class="welcome-sub">问我航司里程 / 权益、信用卡转点、酒店积分互通。</view>
      <view class="popular">
        <view class="popular-hint">大家都在问</view>
        <view class="chip-wrap">
          <t-tag wx:for="{{popular}}" wx:key="id" theme="primary" variant="light"
                 size="large" shape="round" t-class="chip"
                 data-text="{{item.text}}" bindtap="onTapPopular">{{item.text}}</t-tag>
        </view>
      </view>
    </view>

    <!-- 消息列表：官方 chat-message，pending 自动显示加载动画 -->
    <block wx:for="{{messages}}" wx:key="index">
      <t-chat-message role="{{item.role}}"
                      avatar="{{item.role === 'assistant' ? aiAvatar : ''}}"
                      content="{{item.content}}"
                      status="{{item.status}}"
                      placement="{{item.role === 'user' ? 'right' : 'left'}}" />
      <!-- 报错入口：仅对已答完的 AI 回答显示 -->
      <view wx:if="{{item.role === 'assistant' && item.status === 'complete'}}" class="msg-actions">
        <view class="report {{item.reported ? 'is-reported' : ''}}"
              data-index="{{index}}" bindtap="onReport">
          {{item.reported ? '✓ 已反馈' : '👎 报错'}}
        </view>
      </view>
    </block>

    <view wx:if="{{messages.length}}" class="disclaimer">{{disclaimer}}</view>
    <view class="tail"></view>
  </scroll-view>

  <!-- 官方发送器：固定在 tabBar 之上，不随滚动移动 -->
  <view class="sender-fixed">
    <t-chat-sender value="{{input}}" placeholder="输入你的问题…"
                   loading="{{sending}}"
                   bind:change="onInput" bind:send="onSend" bind:stop="onStop" />
  </view>
</view>
