/* 「行程」三页共用的样式。三个页面各自在 wxss 顶部 @import "/styles/rail.wxss";
   变量沿用 app.wxss 里的设计系统（--brand / --surface / --radius-lg …），此处不另立一套。 */

.rail-wrap {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 卡片 ===== */
.rail-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* ===== 分区标题 ===== */
.rail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-weak);
  margin: 8rpx 8rpx 16rpx;
}

/* ===== 一条乘车记录的骨架：左发站 — 中间连线 — 右到站 ===== */
.rail-leg {
  display: flex;
  align-items: center;
}
.rail-leg-end {
  flex: 1;
  min-width: 0;
}
.rail-leg-end.is-right { text-align: right; }
.rail-leg-station {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rail-leg-time {
  font-size: 26rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}
/* 中间那段：一条细线 + 线上的里程数字 */
.rail-leg-mid {
  flex: 0 0 180rpx;
  text-align: center;
  padding: 0 12rpx;
}
.rail-leg-km {
  font-size: 24rpx;
  color: var(--text-weak);
}
.rail-leg-line {
  height: 2rpx;
  background: var(--hairline);
  margin: 8rpx 0;
  position: relative;
}
.rail-leg-line::after {
  content: '';
  position: absolute;
  right: 0;
  top: -5rpx;
  border-left: 12rpx solid var(--hairline);
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
}

/* ===== 统计数字 ===== */
.rail-stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.2;
}
.rail-stat-label {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-top: 6rpx;
}

/* ===== 空状态 ===== */
.rail-empty {
  padding: 120rpx 0 80rpx;
}

/* ===== 右下角浮动主按钮 ===== */
.rail-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: transform .2s var(--ease-spring);
}
.rail-fab:active { transform: scale(.92); }

/* ===== 侧滑删除（与「我的」页保持一致的观感） ===== */
.rail-swipe-del {
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 30rpx;
}

/* ===== 灰掉的过期记录（车次已不在当前运行图） ===== */
.rail-stale { opacity: .6; }
